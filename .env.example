# SIF-Guard environment variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.

# Supabase PostgreSQL connection string (Transaction mode, port 6543)
# Find it at: Supabase dashboard -> Project Settings -> Database ->
#             Connection string -> Transaction mode
# Format: postgresql://postgres.[project-ref]:[password]@[host]:6543/postgres
SUPABASE_DB_URL=postgresql://postgres.nupcindayjsyesaflvmp:[YOUR-DB-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# JWT secret for auth tokens (generate a strong random string)
JWT_SECRET=change-me-to-a-strong-random-secret
